APP_NAME="Prayer API"
APP_VERSION="0.1.0"
ENVIRONMENT="dev"
DEBUG=false

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prayer_api"

CRAWLER_BASE_URL="https://namazvakitleri.diyanet.gov.tr"
CRAWLER_SITEMAP_INDEX_PATHS_CSV="/sitemap.xml,/sitemap-index.xml,/sitemap_index.xml,/sitemaps/sitemap.xml"
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_USER_AGENT="prayer-api/0.1"
CRAWLER_CONCURRENCY=5

GEOCODER_ENABLED=true
GOOGLE_GEOCODING_API_KEY="your-google-api-key-here"
GEOCODER_TIMEOUT_SECONDS=20
GEOCODER_MIN_CONFIDENCE=0.5
SEED_PROBE_TIMEOUT_SECONDS=6
SEED_MAX_BLOCKED_STREAK=5
SEED_LOCATION_FETCH_CONCURRENCY=10
SEED_LOCATION_FETCH_RETRIES=2

SCHEDULER_ENABLED=true
AUTO_WARMUP_ON_MISS=true

# EU + Turkiye, normalized keyword matching
ALLOWED_COUNTRY_KEYWORDS_CSV="turkiye,turkey,almanya,germany,fransa,france,belcika,belgium,hollanda,netherlands,avusturya,austria,isvicre,switzerland,isvec,sweden,norvec,norway,denmark,italya,italy,ispanya,spain,portekiz,portugal,yunanistan,greece,polonya,poland,romanya,romania,macaristan,hungary,hirvatistan,croatia,sirbistan,serbia,bosna,bosnia,arnavutluk,albania,makedonya,kosovo,slovenia,slovakia,cekya,czech,irlanda,ireland,birlesik krallik,united kingdom,uk,finland,estonia,latvia,lithuania,luxembourg,malta,cyprus"

HOT_LOCATIONS_LIMIT=200
